# Every key is optional. With none set the pipeline runs fully offline (template writer,
# procedural images, espeak/silent narration) - set keys to upgrade quality.

# --- LLMs (free tiers / open-weight models), tried in this order -------------------
GROQ_API_KEY=            # https://console.groq.com  - Llama 3.3 70B, free tier
OPENROUTER_API_KEY=      # https://openrouter.ai     - ":free" open models
GEMINI_API_KEY=          # https://aistudio.google.com - Gemini free tier
# OLLAMA_BASE_URL=http://localhost:11434   # local open models, no key (auto-detected)
# SF_LLM_PROVIDERS=groq,openrouter,gemini,ollama,offline

# --- Images ----------------------------------------------------------------------
# Pollinations (FLUX) needs no key and is tried first.
HF_API_TOKEN=            # https://huggingface.co/settings/tokens - FLUX.1-schnell
PEXELS_API_KEY=          # https://www.pexels.com/api - stock photo fallback
# SF_IMAGE_PROVIDERS=pollinations,huggingface,pexels,procedural

# --- Voice (local, open-source) ------------------------------------------------------
# SF_PIPER_MODEL=/path/to/en_US-ryan-medium.onnx   # uv run --extra tts python -m piper.download_voices en_US-ryan-medium
# SF_TTS_PROVIDERS=piper,espeak,silent

# --- Publishing ------------------------------------------------------------------------
# SF_PUBLISHERS=local,youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# SF_YOUTUBE_PRIVACY=private

# --- Runtime ----------------------------------------------------------------------------
# SF_BACKEND=local            # local (SQLite + in-memory bus) | gcp (Firestore + Pub/Sub + GCS)
# SF_MAX_STAGE_ATTEMPTS=3
# SF_MAX_QA_REVISIONS=2
# SF_RENDER_PRESET=veryfast
